{
  "name": "job-hunter-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "once": "tsx src/index.ts --once",
    "probe": "tsx scripts/slugProbe.ts",
    "verify": "tsx scripts/verifyRegistry.ts",
    "scrape": "tsx scripts/scrapeProbe.ts",
    "extract-resume": "tsx src/tools/extractResume.ts",
    "google-auth": "tsx scripts/googleAuth.ts",
    "bootstrap-sheet": "tsx scripts/bootstrapSheet.ts",
    "verify-outreach": "tsx scripts/verifyOutreach.ts",
    "db:push": "tsx scripts/dbPush.ts",
    "db:pull": "tsx scripts/dbPull.ts",
    "blast": "tsx scripts/blast.ts",
    "instahyre": "tsx scripts/instahyre.ts",
    "health": "tsx scripts/registryHealth.ts",
    "probe-url": "tsx scripts/probeUrl.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./test-setup.mjs --import tsx --test \"src/**/*.test.ts\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.5",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "playwright": "^1.60.0",
    "tweetnacl": "^1.0.3",
    "unpdf": "^1.6.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "eslint": "^10.4.1",
    "eslint-plugin-unicorn": "^73.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.60.1"
  }
}
