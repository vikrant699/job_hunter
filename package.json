{
  "name": "job-hunter-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "once": "tsx src/index.ts --once",
    "discover": "tsx src/index.ts --discover",
    "probe": "tsx src/tools/slug-probe.ts",
    "verify": "tsx src/tools/verify-registry.ts",
    "scrape": "tsx src/tools/scrape-probe.ts",
    "repair-urls": "tsx src/tools/repair-urls-tool.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "eval": "tsx src/eval/replay.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.5",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "playwright": "^1.60.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
