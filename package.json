{
  "name": "job-hunter-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "once": "tsx src/index.ts --once",
    "discover": "tsx src/index.ts --discover",
    "probe": "tsx scripts/slug-probe.ts",
    "verify": "tsx scripts/verify-registry.ts",
    "scrape": "tsx scripts/scrape-probe.ts",
    "repair-urls": "tsx scripts/repair-urls-tool.ts",
    "extract-resume": "tsx src/tools/extract-resume.ts",
    "google-auth": "tsx scripts/google-auth.ts",
    "bootstrap-sheet": "tsx scripts/bootstrap-sheet.ts",
    "verify-outreach": "tsx scripts/verify-outreach.ts",
    "blast": "tsx scripts/blast.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./test-setup.mjs --import tsx --test \"src/**/*.test.ts\" \"eval/**/*.test.ts\"",
    "eval": "tsx eval/replay.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.5",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "playwright": "^1.60.0",
    "unpdf": "^1.6.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "eslint": "^10.4.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.60.1"
  }
}
