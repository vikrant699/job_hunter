# Discord webhook URL — required for notifications. Create one in your server's
# channel settings (Edit Channel → Integrations → Webhooks → New Webhook).
# Leave blank to run in mock mode (logs to stderr instead of posting).
DISCORD_WEBHOOK_URL=

# Discord webhook for mid-run PROGRESS heartbeats (posted every 15 min while a
# production tick runs). Separate, shared channel for all profiles. Leave blank to
# skip (progress is logged instead).
DISCORD_PROGRESS_WEBHOOK_URL=

# Ollama HTTP endpoint. Defaults to localhost:11434 if unset.
# The bot uses Ollama for the LLM gate / shortlist / extract calls.
OLLAMA_HOST=http://localhost:11434

# Ollama model to use. Default works on consumer GPUs; pick a bigger model if
# you have the VRAM (e.g. qwen2.5:14b-instruct).
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# Brave Search API key — used by the optional discovery flow to find new
# companies. Free tier is 1000 queries/month. Get one at https://brave.com/search/api/
# Leave blank to skip discovery (you can still curate companies.seed.json manually).
BRAVE_API_KEY=

# Log level: trace | debug | info | warn | error. Default: info
LOG_LEVEL=info
