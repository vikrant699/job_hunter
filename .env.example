# Discord webhook for progress heartbeats and the end-of-run status embed (shared by all profiles). Blank = log only.
DISCORD_PROGRESS_WEBHOOK_URL=

# --- OpenRouter (REQUIRED - the only LLM backend) ---
# API key from https://openrouter.ai/keys. A missing or rejected key aborts the run at pre-flight.
OPENROUTER_API_KEY=
# Model slug. Use the DATED slug: the undated `deepseek/deepseek-v4-flash` alias resolves to an older, pricier build and can move mid-run.
#OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
# Provider pin: comma-separated OpenRouter provider slugs, tried in order, no fallback (the prompt cache is per provider).
# Slugs: https://openrouter.ai/deepseek/deepseek-v4-flash-0731/providers
# Run temp/providerLoadTest.ts before adding any host (some leak other requests' JDs under load).
#OPENROUTER_PROVIDERS=together,inceptron

# Log level: trace | debug | info | warn | error. Default: info
LOG_LEVEL=info

# --- Google (REQUIRED for the sheet registry + outreach drafts + DB sync) ---
# Desktop-app OAuth client from Google Cloud Console (APIs & Services -> Credentials). The DB syncs through Drive with the same client (scope drive.file).
# Scopes are frozen into the refresh token: re-consent once per profile with `npm run google-auth -- --profile <name>`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The outreach spreadsheet's id (the long token in its URL).
GOOGLE_SPREADSHEET_ID=

# Profile whose Google account holds the Drive copy of the DB; set it when you run several profiles, or each forks its own backup.
DB_SYNC_PROFILE=

# --- Network outage handling ---
# A heartbeat probes this URL during a run; while it fails every fetch pauses (unbounded) and resumes when the connection is back.
#NETWORK_PROBE_URL=https://www.google.com/generate_204
#NETWORK_PROBE_INTERVAL_MS=10000
#NETWORK_PROBE_DOWN_INTERVAL_MS=5000
#NETWORK_PROBE_TIMEOUT_MS=5000

# --- Optional tuning ---
# Concurrent LLM calls (default 8).
#LLM_MAX_CONCURRENT=8
# Per-call LLM timeout in ms (default 30000).
#LLM_TIMEOUT_MS=30000
# Max concurrent headless-Chromium pages (default 5).
#PLAYWRIGHT_MAX_PAGES=5
# SQLite path override (tests use this to point at a throwaway DB).
#JOB_HUNTER_DB_PATH=data/job_hunter.db
# Profile selector, equivalent to --profile <name>.
#PROFILE=default
