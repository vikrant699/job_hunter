# Discord webhook for mid-run PROGRESS heartbeats (posted every 15 min while a
# production tick runs) and the single end-of-run status embed. Shared channel
# for all profiles (this is now the ONLY Discord surface - matches themselves
# become Gmail drafts + spreadsheet rows, not per-match Discord pings). Leave
# blank to skip (both are logged instead).
DISCORD_PROGRESS_WEBHOOK_URL=

# Which LLM backend runs the gate / shortlist / extract calls.
#   true  (default) -> local Ollama, using OLLAMA_* below
#   false           -> OpenRouter, using OPENROUTER_* below
# Only the exact word "false" switches providers; anything else (LOCAL=1,
# LOCAL=yes, a typo) falls back to true, so a slip keeps you off the metered API.
LOCAL=true

# Ollama HTTP endpoint. Defaults to localhost:11434 if unset.
# Used when LOCAL=true.
OLLAMA_HOST=http://localhost:11434

# Ollama model to use. The default (qwen3.5:9b) fits an 8 GB GPU with a little
# CPU offload; pick a bigger model if you have the VRAM (e.g. qwen2.5:14b-instruct).
OLLAMA_MODEL=qwen3.5:9b

# --- OpenRouter (only needed when LOCAL=false) ---
# API key from https://openrouter.ai/keys. Credits are prepaid pay-as-you-go.
# A missing or rejected key aborts the run at pre-flight, before any scraping.
OPENROUTER_API_KEY=
# Model slug. DeepSeek V4 Flash is the cost-effective pick for the gate: cheap
# per token, strong instruction-following, and automatic prompt caching (the
# resume + rubric prefix is ~80% of every gate call).
# Use the DATED slug. The undated `deepseek/deepseek-v4-flash` alias resolves to
# the older 0423 build, which also costs 55% more ($0.14/M in vs $0.09/M), and an
# alias can move under a running sweep. Pre-flight verifies the slug resolves.
#OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

# Log level: trace | debug | info | warn | error. Default: info
LOG_LEVEL=info

# --- Google (REQUIRED for the sheet registry + outreach drafts + DB sync) ---
# The DB is synced between machines through Drive using this same OAuth client
# (scope drive.file - app-created files only). No extra credentials needed, but
# scopes are frozen into a refresh token when it is granted, so an existing token
# CANNOT gain drive.file - you MUST re-consent once per profile:
#   npm run google-auth -- --profile <name>
# `npm run once` then pulls before the run and pushes after it.
# Desktop-app OAuth client from Google Cloud Console (APIs & Services ->
# Credentials -> Create credentials -> OAuth client ID -> Desktop app).
# After filling these in, run: npm run google-auth -- --profile <name>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The outreach spreadsheet's id (the long token in its URL).
GOOGLE_SPREADSHEET_ID=

# Which profile's Google account holds the Drive copy of the database. Profiles
# are SEPARATE Google accounts, and drive.file only ever sees files created under
# the signed-in one - so leaving this blank with two profiles means each creates
# its own backup and pulls it over the shared local DB. Set it to the profile that
# owns the backup; the others skip sync instead of forking it.
DB_SYNC_PROFILE=

# --- Network outage handling ---
# A heartbeat probes this URL during a run; while it fails, every fetch (boards, JDs,
# OpenRouter, Google) pauses and resumes when the connection is back, instead of
# failing its way through the company list. The target only answers "do we have a
# connection" - it is not a health check for any board. Waiting is unbounded.
#NETWORK_PROBE_URL=https://www.google.com/generate_204
#NETWORK_PROBE_INTERVAL_MS=10000
#NETWORK_PROBE_DOWN_INTERVAL_MS=5000
#NETWORK_PROBE_TIMEOUT_MS=5000

# --- Optional tuning ---
# Ollama context window tokens (default 9000; see src/config.ts llm.numCtx).
#OLLAMA_NUM_CTX=9000
# Concurrent LLM calls. Defaults to 1 when LOCAL=true (Ollama serializes on the
# GPU) and 8 when LOCAL=false (a hosted API has no such constraint).
#LLM_MAX_CONCURRENT=8
# Per-call LLM timeout in ms. Defaults to 90000 local, 30000 for OpenRouter.
#LLM_TIMEOUT_MS=30000
# Max concurrent headless-Chromium pages (default 5).
#PLAYWRIGHT_MAX_PAGES=5
# SQLite path override (tests use this to point at a throwaway DB).
#JOB_HUNTER_DB_PATH=data/job_hunter.db
# Profile selector, equivalent to --profile <name>.
#PROFILE=default
